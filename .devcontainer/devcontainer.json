{
  "name": "Goalpost",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "npm ci --no-audit --no-fund && pip install --user genvm-linter",
  "forwardPorts": [4173, 5173],
  "portsAttributes": {
    "4173": { "label": "Evidence pages (validators read these)", "onAutoForward": "silent" },
    "5173": { "label": "Web console (npm run dev)", "onAutoForward": "notify" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["docs/e2e.md"] },
    "vscode": { "extensions": ["ms-python.python", "dbaeumer.vscode-eslint"] }
  },
  "containerEnv": { "GOALPOST_RPC": "https://studio.genlayer.com/api" }
}
